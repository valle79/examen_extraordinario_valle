# =============================================
# Matricula Cloud 360 Enterprise
# Plantilla de variables de entorno
# =============================================
# Copiar a .env y personalizar:
#     cp .env.example .env
#
# IMPORTANTE: .env esta excluido del control de versiones
# (.gitignore). Nunca subir contrasenas al repositorio.

# Contrasena del usuario SA (administrador de SQL Server)
# Requisitos: minimo 8 caracteres, mayuscula, minuscula, numero y simbolo
SA_PASSWORD=CambiaEstaPassword!123

# Edicion de SQL Server (Developer es gratuita para desarrollo)
MSSQL_PID=Developer

# Puerto de exposicion de SQL Server en el host
SQL_SERVER_PORT=1433

# Nombre del contenedor
CONTAINER_NAME=sqlserver_matricula_cloud

# Zona horaria del contenedor
TZ=America/Lima

# Retencion de respaldos (dias): .bak (FULL/DIFF) y .trn (LOG).
# Lo mas antiguo se elimina automaticamente (volumen + proyecto).
BACKUP_RETENTION_FULL_DAYS=7
BACKUP_RETENTION_LOG_DAYS=2
